# ==============================================================================
# FLOP Network GPU Miner Configuration Template
# Copy this file to miner-01.env and update with your own values:
#   cp miner.env.example miner-01.env && chmod 600 miner-01.env
# ==============================================================================

COMPOSE_PROJECT_NAME=flop-miner-01
WORKER_NAME=devnet-miner-01

# --- Docker Images (Use qualified tags or digests) ---
FLOP_WORKER_IMAGE=ghcr.io/flop-labs/flop-core/miner-worker:stable
FLOP_BACKEND_IMAGE=ghcr.io/flop-labs/flop-core/miner-vllm-toploc:stable
FLOP_CLI=ghcr.io/flop-labs/flop-core/cli:stable

# --- FLOP Network RPC & Endpoints ---
FLOP_RPC=wss://rpc.devnet.flop.network
GHOST_MAILBOX_URL=https://mailbox.devnet.flop.network
DA_URL=http://da.flop.invalid:7001

# --- Host Secret Key Paths (Root-owned, 0600 permissions) ---
MINER_SIGNER_FILE=/opt/flop-miner/signer
MINER_ENCLAVE_KEY_FILE=/opt/flop-miner/session-keys/enclave.seed
GHOST_KEY_FILE=/data/ghost-x25519.json

# --- Registered Model Configuration ---
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
OPENROUTER_MODEL_SLUG=qwen/qwen2.5-0.5b-instruct
# On-chain model hash (retrieve from releases.json or network operator):
MODEL_HASH=0xREPLACE_WITH_REGISTERED_MODEL_HASH
MODEL_CHECKPOINT_DIR=/opt/flop-miner/models/qwen2.5-0.5b-instruct
MODEL_PRECISION=BF16
TOPLOC_PRECISION=bf16

# --- Decode Policy (Leave empty; auto-filled by scripts/decode-policy.sh) ---
DECODE_POLICY=
DECODE_POLICY_HASH=

# --- Internal Inference Backend API ---
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# Generate with: openssl rand -hex 32
INFERENCE_API_KEY=REPLACE_WITH_RANDOM_HEX32

# --- Session Ingress & Public TLS ---
SESSION_BIND_IP=127.0.0.1
SESSION_HOST_PORT=8645
# Fully Qualified Domain Name pointing to this host (Ports 80 & 443 open)
SESSION_PUBLIC_HOST=miner.yourdomain.com
# Generate with: openssl rand -hex 32
SESSION_AUTH_TOKEN=REPLACE_WITH_RANDOM_HEX32
